rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Accounts: Users can read/write their own account document
    match /accounts/{email} {
      allow read, write: if true;
    }
    
    // Payment Slips: Bank transfer slips for VIP access (Allow create, read, update, delete for Admin)
    match /slips/{slipId} {
      allow read, write: if true;
    }
    
    // IP logs & audit
    match /ip_logs/{logId} {
      allow read, write: if true;
    }

    // OTP verification records
    match /otps/{email} {
      allow read, write: if true;
    }

    // Public settings: readable and writable by dashboard/admin
    match /settings/{doc} {
      allow read, write: if true;
    }
  }
}
