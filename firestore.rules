rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Accounts: Users can read/write their own account document
    match /accounts/{email} {
      allow read, write: if request.auth != null;
    }
    
    // Payment Slips: Authenticated users can submit, only admin can delete
    match /slips/{slipId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
    }
    
    // IP logs & audit
    match /ip_logs/{logId} {
      allow read, write: if request.auth != null;
    }

    // Public settings: readable by anyone, writable only by admin
    match /settings/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
