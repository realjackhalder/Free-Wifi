# ==============================================================================
# Free Wi-Fi Captive Portal & Gateway Server — Environment Configuration
# Copy this file to .env on your VPS and configure: cp .env.example .env
# ==============================================================================

# Network Binding
HOST=0.0.0.0
ADMIN_PORT=3000
USER_PORT=3001

# Public IP or Domain of your VPS
# If your VPS is behind NAT (e.g. 172.16.0.2 / 10.0.0.x), set your public IP/domain here
# so client devices will be redirected to the accessible public address.
# Examples:
# PORTAL_IP=203.0.113.5
# PORTAL_IP=wifi.yourdomain.com
PORTAL_IP=

# Firewall Mode
# Set to 'false' on Linux VPS to execute real iptables rules
# Set to 'true' to run in safe emulated mode without touching system firewall
DRY_RUN=false

# WireGuard VPN Server (Optional)
# WG_PORT=51820
# WG_INTERFACE=wg0

# Cloud Storage & Firebase Overrides (Optional - defaults to project config)
# FIREBASE_STORAGE_BUCKET=free-wifi-portal.firebasestorage.app
# FIREBASE_DATABASE_URL=https://free-wifi-portal-default-rtdb.asia-southeast1.firebasedatabase.app
